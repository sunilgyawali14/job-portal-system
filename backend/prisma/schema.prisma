// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================================================
// ENUMS
// ============================================================================

enum Role {
  CANDIDATE
  RECRUITER
  ADMIN
}

enum SkillProficiency {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  EXPERT
}

enum LanguageProficiency {
  BASIC
  CONVERSATIONAL
  FLUENT
  NATIVE
}

enum CompanySize {
  STARTUP_1_10
  SMALL_11_50
  MEDIUM_51_200
  LARGE_201_1000
  ENTERPRISE_1000_PLUS
}

enum VerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  REJECTED
}

enum JobType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERNSHIP
  FREELANCE
  TEMPORARY
}

enum WorkMode {
  ONSITE
  REMOTE
  HYBRID
}

enum ExperienceLevel {
  INTERNSHIP
  ENTRY
  MID
  SENIOR
  LEAD
  EXECUTIVE
}

enum JobStatus {
  DRAFT
  PUBLISHED
  CLOSED
  ARCHIVED
}

enum ApplicationStatus {
  APPLIED
  UNDER_REVIEW
  SHORTLISTED
  INTERVIEW_SCHEDULED
  OFFERED
  HIRED
  REJECTED
  WITHDRAWN
}

enum SalaryType {
  HOURLY
  MONTHLY
  YEARLY
}

enum InterviewMode {
  ONLINE
  ONSITE
  PHONE
}

enum InterviewStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  RESCHEDULED
}

enum TokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
  MAGIC_LINK
  TWO_FACTOR
}

enum AlertFrequency {
  INSTANT
  DAILY
  WEEKLY
}

// ============================================================================
// AUTHENTICATION, TOKENS & USER MANAGEMENT
// ============================================================================

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  passwordHash    String
  role            Role
  isActive        Boolean   @default(true)
  isEmailVerified Boolean   @default(false)
  isDeleted       Boolean   @default(false)
  deletedAt       DateTime?
  lastLoginAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relations
  candidateProfile   CandidateProfile?
  refreshTokens      RefreshToken[]
  messagesSent       Message[]
  verificationTokens VerificationToken[]
  jobAlerts          JobAlert[]

  @@index([role])
  @@index([isActive])
  @@index([isDeleted])
  @@map("users")
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  isRevoked Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model VerificationToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String    @unique
  type      TokenType
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([token, type])
  @@index([expiresAt])
  @@map("verification_tokens")
}

// ============================================================================
// CANDIDATE PROFILE
// ============================================================================

model CandidateProfile {
  id                String    @id @default(cuid())
  userId            String    @unique
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstName         String
  lastName          String
  phone             String?
  dateOfBirth       DateTime?
  profilePictureUrl String?
  headline          String?
  bio               String?
  country           String?
  province          String?
  district          String?
  city              String?
  address           String?
  expectedSalaryMin Int?
  expectedSalaryMax Int?
  salaryCurrency    String?   @default("NPR")
  noticePeriodDays  Int?
  isOpenToWork      Boolean   @default(true)

  // AI Job Matching Embeddings / Vector / Data
  embedding        Json?
  aiProfileSummary String?
  matchKeywords    String[]

  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  // Relations
  educations      Education[]
  experiences     Experience[]
  candidateSkills CandidateSkill[]
  certifications  Certification[]
  languages       Language[]
  projects        Project[]
  applications    Application[]
  savedJobs       SavedJob[]

  @@index([isOpenToWork])
  @@index([city])
  @@index([country, city])
  @@index([isDeleted])
  @@map("candidate_profiles")
}

model Education {
  id                 String           @id @default(cuid())
  candidateProfileId String
  candidateProfile   CandidateProfile @relation(fields: [candidateProfileId], references: [id], onDelete: Cascade)
  institution        String
  degree             String
  fieldOfStudy       String?
  startDate          DateTime
  endDate            DateTime?
  grade              String?
  description        String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@index([candidateProfileId])
  @@map("educations")
}

model Experience {
  id                 String           @id @default(cuid())
  candidateProfileId String
  candidateProfile   CandidateProfile @relation(fields: [candidateProfileId], references: [id], onDelete: Cascade)
  companyName        String
  jobTitle           String
  employmentType     JobType?
  location           String?
  startDate          DateTime
  endDate            DateTime?
  isCurrent          Boolean          @default(false)
  description        String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@index([candidateProfileId])
  @@map("experiences")
}

model Skill {
  id              String           @id @default(cuid())
  name            String           @unique
  category        String?
  createdAt       DateTime         @default(now())
  candidateSkills CandidateSkill[]
  jobSkills       JobSkill[]

  @@index([category])
  @@index([name])
  @@map("skills")
}

model CandidateSkill {
  id                 String           @id @default(cuid())
  candidateProfileId String
  candidateProfile   CandidateProfile @relation(fields: [candidateProfileId], references: [id], onDelete: Cascade)
  skillId            String
  skill              Skill            @relation(fields: [skillId], references: [id], onDelete: Cascade)
  proficiency        SkillProficiency @default(INTERMEDIATE)
  yearsOfExperience  Int?
  createdAt          DateTime         @default(now())

  @@unique([candidateProfileId, skillId])
  @@index([skillId])
  @@map("candidate_skills")
}

model Certification {
  id                  String           @id @default(cuid())
  candidateProfileId  String
  candidateProfile    CandidateProfile @relation(fields: [candidateProfileId], references: [id], onDelete: Cascade)
  name                String
  issuingOrganization String
  issueDate           DateTime?
  expiryDate          DateTime?
  credentialId        String?
  credentialUrl       String?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  @@index([candidateProfileId])
  @@map("certifications")
}

model Language {
  id                 String              @id @default(cuid())
  candidateProfileId String
  candidateProfile   CandidateProfile    @relation(fields: [candidateProfileId], references: [id], onDelete: Cascade)
  name               String
  proficiency        LanguageProficiency @default(CONVERSATIONAL)
  createdAt          DateTime            @default(now())

  @@unique([candidateProfileId, name])
  @@map("languages")
}

model Project {
  id                 String           @id @default(cuid())
  candidateProfileId String
  candidateProfile   CandidateProfile @relation(fields: [candidateProfileId], references: [id], onDelete: Cascade)
  title              String
  description        String?
  projectUrl         String?
  repositoryUrl      String?
  techStack          String[]
  startDate          DateTime?
  endDate            DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@index([candidateProfileId])
  @@map("projects")
}

// ============================================================================
// COMPANY & JOBS
// ============================================================================

model Company {
  id                 String             @id @default(cuid())
  name               String
  slug               String             @unique
  logoUrl            String?
  website            String?
  industry           String?
  companySize        CompanySize?
  foundedYear        Int?
  description        String?
  country            String?
  province           String?
  district           String?
  city               String?
  address            String?
  postalCode         String?
  verificationStatus VerificationStatus @default(UNVERIFIED)
  verifiedAt         DateTime?

  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  // Relations
  jobs Job[]

  @@index([verificationStatus])
  @@index([industry])
  @@index([city])
  @@index([isDeleted])
  @@map("companies")
}

model JobCategory {
  id          String        @id @default(cuid())
  name        String        @unique
  slug        String        @unique
  description String?
  icon        String?
  parentId    String?
  parent      JobCategory?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children    JobCategory[] @relation("CategoryHierarchy")

  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  jobs Job[]

  @@index([parentId])
  @@index([slug])
  @@index([isDeleted])
  @@map("job_categories")
}

model Job {
  id         String   @id @default(cuid())
  companyId  String
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  postedById String?

  categoryId String?
  category   JobCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  title            String
  slug             String          @unique
  description      String
  aboutCompany     String?
  responsibilities String?
  requirements     String?
  benefits         String?
  perks            String?
  jobType          JobType
  workMode         WorkMode        @default(ONSITE)
  experienceLevel  ExperienceLevel

  minSalary  Int?
  maxSalary  Int?
  currency   String?     @default("NPR")
  salaryType SalaryType?

  country             String?
  province            String?
  district            String?
  city                String?
  address             String?
  vacancy             Int?      @default(1)
  status              JobStatus @default(DRAFT)
  isFeatured          Boolean   @default(false)
  isUrgent            Boolean   @default(false)
  applicationDeadline DateTime?
  publishedAt         DateTime?

  // AI Job Matching Fields
  embedding          Json?
  aiMatchingKeywords String[]

  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  // Relations
  jobSkills    JobSkill[]
  applications Application[]
  savedBy      SavedJob[]
  interviews   Interview[]

  @@index([companyId])
  @@index([categoryId])
  @@index([status])
  @@index([jobType])
  @@index([workMode])
  @@index([experienceLevel])
  @@index([city])
  @@index([publishedAt])
  @@index([status, publishedAt])
  @@index([status, isDeleted, publishedAt])
  @@index([title])
  @@index([minSalary, maxSalary])
  @@index([isDeleted])
  @@map("jobs")
}

model JobSkill {
  id         String   @id @default(cuid())
  jobId      String
  job        Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  skillId    String
  skill      Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)
  isRequired Boolean  @default(true)
  createdAt  DateTime @default(now())

  @@unique([jobId, skillId])
  @@index([skillId])
  @@map("job_skills")
}

model SavedJob {
  id                 String           @id @default(cuid())
  candidateProfileId String
  candidateProfile   CandidateProfile @relation(fields: [candidateProfileId], references: [id], onDelete: Cascade)
  jobId              String
  job                Job              @relation(fields: [jobId], references: [id], onDelete: Cascade)
  createdAt          DateTime         @default(now())

  @@unique([candidateProfileId, jobId])
  @@index([jobId])
  @@index([candidateProfileId])
  @@map("saved_jobs")
}

model JobAlert {
  id              String           @id @default(cuid())
  userId          String
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  name            String
  keywords        String?
  location        String?
  jobType         JobType?
  workMode        WorkMode?
  experienceLevel ExperienceLevel?
  minSalary       Int?
  frequency       AlertFrequency   @default(DAILY)
  isActive        Boolean          @default(true)
  lastSentAt      DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([userId])
  @@index([isActive])
  @@map("job_alerts")
}

// ============================================================================
// APPLICATION & INTERVIEW
// ============================================================================

model Application {
  id                 String           @id @default(cuid())
  jobId              String
  job                Job              @relation(fields: [jobId], references: [id], onDelete: Cascade)
  candidateProfileId String
  candidateProfile   CandidateProfile @relation(fields: [candidateProfileId], references: [id], onDelete: Cascade)
  resumeId           String?

  resumeSnapshotUrl String?
  resumeVersion     Int?
  coverLetter       String?
  expectedSalary    Int?
  noticePeriodDays  Int?
  recruiterNotes    String?
  status            ApplicationStatus @default(APPLIED)

  // AI Match Score
  aiMatchScore   Float?
  aiMatchDetails Json?

  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  appliedAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  interviews   Interview[]
  conversation Conversation?

  @@unique([jobId, candidateProfileId])
  @@index([candidateProfileId])
  @@index([jobId])
  @@index([status])
  @@index([jobId, status])
  @@index([isDeleted])
  @@map("applications")
}

model Interview {
  id              String          @id @default(cuid())
  applicationId   String
  application     Application     @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  jobId           String
  job             Job             @relation(fields: [jobId], references: [id], onDelete: Cascade)
  title           String
  description     String?
  scheduledAt     DateTime
  durationMinutes Int?
  mode            InterviewMode
  meetingLink     String?
  location        String?
  status          InterviewStatus @default(SCHEDULED)
  feedback        String?
  rating          Int?

  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([applicationId])
  @@index([jobId])
  @@index([scheduledAt])
  @@index([isDeleted])
  @@map("interviews")
}

// ============================================================================
// COMMUNICATION
// ============================================================================

model Conversation {
  id            String      @id @default(cuid())
  applicationId String      @unique
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  messages Message[]

  @@map("conversations")
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)
  message        String
  attachmentUrl  String?
  isRead         Boolean      @default(false)
  createdAt      DateTime     @default(now())

  @@index([conversationId])
  @@index([senderId])
  @@map("messages")
}
